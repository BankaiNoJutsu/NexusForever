<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <variable name="minLogLevel" value="Trace"/>
    <time type="FastUTC"/>
    <targets>
        <target name="console" xsi:type="AsyncWrapper" queueLimit="10000" overflowAction="Discard">
            <target xsi:type="ColoredConsole" layout="[${uppercase:${level}}][${logger:shortName=true}] ${message} ${exception:format=tostring}"/>
        </target>
        <target name="file" xsi:type="AsyncWrapper" queueLimit="200000" overflowAction="Grow">
            <target xsi:type="File"
                    fileName="${basedir}/logs/${processname:whenEmpty=worldserver}_${date:format=yyyyMMdd}_${processid}.log"
                    keepFileOpen="true"
                    concurrentWrites="false"
                    layout="${longdate}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}"/>
        </target>
    </targets>
    <rules>
        <logger name="*" writeTo="console,file" minLevel="${var:minLogLevel}"/>
    </rules>
</nlog>
